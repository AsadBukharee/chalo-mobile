# Copy to .env and fill in. .env is gitignored; EAS builds read these from
# eas.json instead, because EAS only uploads files git tracks.
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle and is therefore
# public. Never put a secret here — no Cloudinary API secret, no signing key.
# After changing any of these, restart Metro with a cleared cache:
#
#   npx expo start -c

# Cloudinary — unsigned direct upload (lib/cloudinary.ts)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=deupmoy95
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=chalo_mobile

# Google Maps — overrides the fallback in app.config.js
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Django API base URL. Defaults to the deployed backend in app.config.js;
# set this to point at a local runserver instead, e.g.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000
# (use your machine's LAN IP, not localhost — that resolves to the phone).
# EXPO_PUBLIC_API_BASE_URL=https://chalo-backend.vercel.app
